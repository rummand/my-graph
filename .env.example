# Postgres (docker compose: npm run db:up)
DATABASE_URL=postgres://mygraph:mygraph@localhost:5433/mygraph

# mux model gateway (OpenAI/Anthropic compatible). Create a tenant key for "my-graph" in the mux dashboard.
MUX_BASE_URL=http://127.0.0.1:7070
MUX_API_KEY=

# Session cookie signing secret (openssl rand -hex 32)
SESSION_SECRET=

# WebAuthn relying party
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Where uploaded originals are stored
UPLOAD_DIR=./data/uploads
