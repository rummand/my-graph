      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj oplysning"
          }
        }
      }
    },
    "Add letters, photos and scans. The assistant reads them and finds dates, people and things to do.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj breve, billeder og scanninger. Assistenten læser dem og finder datoer, personer og ting, der skal gøres."
          }
        }
      }
    },
    "Add person": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj person"
          }
        }
      }
    },
    "Add reminder": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj påmindelse"
          }
        }
      }
    },
    "Add the people in your life, or upload a letter and the assistant will find them.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj de mennesker, du har i dit liv, eller upload et brev, så finder assistenten dem."
          }
        }
      }
    },
