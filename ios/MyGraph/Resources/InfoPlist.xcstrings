{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of a letter or note to add it to your library."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag et billede af et brev eller en seddel for at føje det til dit bibliotek."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos to add to your library."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg billeder, der skal føjes til dit bibliotek."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak your question in Ask instead of typing it."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sig dit spørgsmål i Spørg i stedet for at skrive det."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn what you say in Ask into text. When the iPhone can, this happens on the iPhone itself."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør det, du siger i Spørg, til tekst. Når iPhonen kan, sker det på selve iPhonen."
          }
        }
      }
    }
  }
}