    },
    "Review": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemse"
          }
        }
      }
    },
    "Save note": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem note"
          }
        }
      }
    },
    "Saved": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt"
          }
        }
      }
    },
    "Saved to My Graph.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt i My Graph."
          }
        }
      }
    },
    "Saved to the library. Anything My Graph finds in it is proposed for you to approve.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmes i biblioteket. Det, My Graph finder i den, bliver foreslået dig til godkendelse."
          }
        }
      }
    },
    "Saves a note to the library of your current graph. Only you can see it until you share it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer en note i biblioteket i din nuværende graf. Kun du kan se den, til du deler den."
          }
        }
      }
    },
    "Send %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send %@"
          }
        }
      }
    },
    "Send now": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send nu"
          }
        }
      }
    },
    "Send photos…": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send billeder …"
          }
        }
      }
    },
    "Sending from this Mac": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendes fra denne Mac"
          }
        }
      }
    },
    "Sending…": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender …"
          }
        }
      }
    },
    "Sends events from the last 30 days and the next 120 days. Events you approve in My Graph appear in a “My Graph” calendar here; your own calendars are never changed.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender begivenheder fra de sidste 30 dage og de næste 120 dage. Begivenheder, du godkender i My Graph, vises i en kalender, “My Graph”, her; dine egne kalendere ændres aldrig."
          }
        }
      }
    },
    "Sends names, numbers, email addresses, addresses, birthdays and related names from Contacts. Only cards that changed are sent again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender navne, numre, e-mailadresser, adresser, fødselsdage og relaterede navne fra Kontakter. Kun kort, der er ændret, sendes igen."
          }
        }
      }
    },
    "Sends new and changed files from the folders you pick. Each change becomes a new version of the same document. Hidden files, temporary files and files over 50 MB are skipped.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender nye og ændrede filer fra de mapper, du vælger. Hver ændring bliver en ny version af det samme dokument. Skjulte filer, midlertidige filer og filer over 50 MB springes over."
          }
        }
      }
    },
    "Sends the list of Notes folders (names only) and opens My Graph, where you choose.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender listen over mapper i Noter (kun navne) og åbner My Graph, hvor du vælger."
          }
        }
      }
    },
    "Sends the list of conversations (names only) and opens My Graph, where you tick the ones to send.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender listen over samtaler (kun navne) og åbner My Graph, hvor du sætter flueben ved dem, der skal sendes."
          }
        }
      }
    },
    "Sends the photos you pick, with when and where they were taken. Sending the details of every photo (no images) is a separate choice.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender de billeder, du vælger, med hvornår og hvor de blev taget. At sende oplysninger om alle billeder (uden selve billederne) er et særskilt valg."
          }
        }
      }
    },
    "Sends who you called and who called you, when, and for how long, from this Mac's call history. Never any audio.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender, hvem du ringede til, og hvem der ringede til dig, hvornår og hvor længe, fra denne Macs opkaldshistorik. Aldrig lyd."
          }
        }
      }
    },
    "Sends your Voice Memos recordings, so they can be transcribed in My Graph.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender dine optagelser fra Memoer, så de kan skrives ud i My Graph."
          }
        }
      }
    },
    "Sends your reminders. Reminders you approve in My Graph appear in a “My Graph” list; when you tick one off there, My Graph hears about it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender dine påmindelser. Påmindelser, du godkender i My Graph, vises i en liste, “My Graph”; når du krydser en af der, får My Graph besked."
          }
        }
      }
    },
    "Server": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillinger …"
          }
        }
      }
    },
    "Shortcuts work in every app. Also in the Shortcuts app: “Ask My Graph” and “Add note to My Graph”.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genvejene virker i alle apps. Også i appen Genveje: “Spørg My Graph” og “Tilføj note til My Graph”."
          }
        }
      }
    },
    "Show approved events in a “My Graph” calendar": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis godkendte begivenheder i en kalender, “My Graph”"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis i Finder"
          }
        }
      }
    },
    "Sign in": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind"
          }
        }
      }
    },
    "Sign in to My Graph": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på My Graph"
          }
        }
      }
    },
    "Sign in to My Graph on this Mac first.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log først ind på My Graph på denne Mac."
          }
        }
      }
    },
    "Sign in to ask.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind for at spørge."
          }
        }
      }
    },
    "Sign in to send what you choose from this Mac to your graph.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind for at sende det, du vælger, fra denne Mac til din graf."
          }
        }
      }
    },
    "Sign in under Account first.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log først ind under Konto."
          }
        }
      }
    },
    "Sign in with a passkey": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med en adgangsnøgle"
          }
        }
      }
    },
    "Sign in…": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind …"
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ud"
          }
        }
      }
    },
    "Signed in as": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logget ind som"
          }
        }
      }
    },
    "Signed in on this Mac": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logget ind på denne Mac"
          }
        }
      }
    },
    "Some photos only": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun nogle billeder"
          }
        }
      }
    },
    "Something went wrong on the server. The app tries again later.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget gik galt på serveren. Appen prøver igen senere."
          }
        }
      }
    },
    "Sources": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilder"
          }
        }
      }
    },
    "Space": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellemrum"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "Stop watching this folder": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold op med at følge denne mappe"
          }
        }
      }
    },
    "Switch": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift"
          }
        }
      }
    },
    "Switch graph: Ask, notes and what this Mac sends go to the graph you pick.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift graf: Spørg, noter og det, denne Mac sender, går til den graf, du vælger."
          }
        }
      }
    },
    "That batch was too large for My Graph.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den portion var for stor til My Graph."
          }
        }
      }
    },
    "That doesn't look like a web address.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ligner ikke en webadresse."
          }
        }
      }
    },
    "The folder “%@” can't be opened. Choose it again in Settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen “%@” kan ikke åbnes. Vælg den igen i Indstillinger."
          }
        }
      }
    },
    "The note couldn't be saved.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noten kunne ikke gemmes."
          }
        }
      }
    },
    "The server can't be reached. The app tries again when you're online.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren kan ikke nås. Appen prøver igen, når du er online."
          }
        }
      }
    },
    "The server sent something this app doesn't understand. Try updating the app.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren sendte noget, appen ikke forstår. Prøv at opdatere appen."
          }
        }
      }
    },
    "There is no calendar account on this Mac to keep the My Graph calendar in.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen kalenderkonto på denne Mac at gemme kalenderen My Graph i."
          }
        }
      }
    },
    "There is nothing to read on this Mac.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er intet at læse på denne Mac."
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac"
          }
        }
      }
    },
    "This Mac can't use a passkey for this server yet (a signed build is needed). Sign in with your password.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac kan ikke bruge en adgangsnøgle til denne server endnu (det kræver en signeret version). Log ind med din adgangskode."
          }
        }
      }
    },
    "This Mac is paused in My Graph. Resume it on the web (Connections, My Graph for Mac).": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac er sat på pause i My Graph. Fortsæt på nettet (Forbindelser, My Graph til Mac)."
          }
        }
      }
    },
    "This Mac isn't signed in to My Graph any more. Sign in again in Settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac er ikke længere logget ind på My Graph. Log ind igen i Indstillinger."
          }
        }
      }
    },
    "This Mac sends only what you turn on under Sources, to the graph shown here. Nothing is added to your graph until you approve it in My Graph.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac sender kun det, du slår til under Kilder, til den graf, der vises her. Intet føjes til din graf, før du har godkendt det i My Graph."
          }
        }
      }
    },
    "This Mac was signed out of My Graph (maybe it was signed in again elsewhere, or the helper was paired). Sign in again in Settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac blev logget ud af My Graph (måske blev der logget ind igen et andet sted, eller hjælperen blev parret). Log ind igen i Indstillinger."
          }
        }
      }
    },
    "This event has no start time.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begivenheden har intet starttidspunkt."
          }
        }
      }
    },
    "This folder isn't chosen in My Graph any more. Add it again in Settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen er ikke længere valgt i My Graph. Tilføj den igen i Indstillinger."
          }
        }
      }
    },
    "This server doesn't have My Graph for Mac yet. Update My Graph on the server.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne server har ikke My Graph til Mac endnu. Opdater My Graph på serveren."
          }
        }
      }
    },
    "This source is turned off in My Graph.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kilde er slået fra i My Graph."
          }
        }
      }
    },
    "This source was turned off in My Graph.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kilde blev slået fra i My Graph."
          }
        }
      }
    },
    "Tick one off in Reminders and it is done in My Graph too. Your other lists are never changed.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryds en af i Påmindelser, så er den også klaret i My Graph. Dine andre lister ændres aldrig."
          }
        }
      }
    },
    "Turn this on again to let macOS ask for permission.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå dette til igen, så macOS kan spørge om tilladelse."
          }
        }
      }
    },
    "Type the shortcut…": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tast genvejen …"
          }
        }
      }
    },
    "Up to date, checked %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdateret, tjekket %@"
          }
        }
      }
    },
    "Upcoming events from My Graph, read-only. Your other calendars are never changed.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommende begivenheder fra My Graph, kun til visning. Dine andre kalendere ændres aldrig."
          }
        }
      }
    },
    "Use the same email and password as on the web. Signing in connects this Mac; you choose what it sends under Sources.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug samme e-mail og adgangskode som på nettet. Når du logger ind, forbindes denne Mac; du vælger under Kilder, hvad den sender."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "Voice Memos": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoer"
          }
        }
      }
    },
    "Waiting for you: %lld": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på dig: %lld"
          }
        }
      }
    },
    "Waiting for your permission": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på din tilladelse"
          }
        }
      }
    },
    "Watch folder": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg mappe"
          }
        }
      }
    },
    "Who can see it": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem kan se det"
          }
        }
      }
    },
    "Writing back to this Mac is turned off.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivning tilbage til denne Mac er slået fra."
          }
        }
      }
    },
    "You can only look at this graph now, so nothing can be added to it from this Mac.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kun se denne graf nu, så intet kan føjes til den fra denne Mac."
          }
        }
      }
    },
    "You can only look at this graph, so nothing can be added to it from this Mac.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kun se denne graf, så intet kan føjes til den fra denne Mac."
          }
        }
      }
    },
    "You're no longer a member of the graph this Mac sends to. Sign in again and choose another graph.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er ikke længere medlem af den graf, denne Mac sender til. Log ind igen, og vælg en anden graf."
          }
        }
      }
    },
    "You're signed out. Nothing is sent from this Mac until you sign in again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er logget ud. Intet sendes fra denne Mac, før du logger ind igen."
          }
        }
      }
    },
    "Your session has ended. Syncing goes on, but Ask and Quick note need you to sign in again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din session er udløbet. Synkroniseringen fortsætter, men Spørg og Hurtig note kræver, at du logger ind igen."
          }
        }
      }
    },
    "Your session on this Mac has ended. Syncing goes on in the background.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din session på denne Mac er udløbet. Synkroniseringen fortsætter i baggrunden."
          }
        }
      }
    },
    "just now": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "lige nu"
          }
        }
      }
    }
  },
  "version": "1.0"
}
