    "Each source is off until you turn it on. What this Mac sends arrives in My Graph as proposals, and nothing is added to your graph until you approve it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver kilde er slået fra, til du slår den til. Det, denne Mac sender, kommer ind i My Graph som forslag, og intet føjes til din graf, før du har godkendt det."
          }
        }
      }
    },
    "Email": {
      "localizations": {
