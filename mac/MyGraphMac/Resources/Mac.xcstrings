    },
    "My Graph needs you": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "My Graph har brug for dig"
          }
        }
      }
    },
    "My Graph sends new and changed files from these folders. Nothing is added to your graph until you approve it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "My Graph sender nye og ændrede filer fra disse mapper. Intet føjes til din graf, før du har godkendt det."
          }
        }
      }
    },
    "My Graph sends what you turned on every 15 minutes, and soon after files, calendars or reminders change.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "My Graph sender det, du har slået til, hvert kvarter og kort efter, at filer, kalendere eller påmindelser ændrer sig."
          }
        }
      }
    },
    "My Graph tells you when proposals are waiting for you, and when a source needs you (a permission, a sign-in).": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "My Graph giver besked, når forslag venter på dig, og når en kilde har brug for dig (en tilladelse, et login)."
          }
        }
      }
    },
